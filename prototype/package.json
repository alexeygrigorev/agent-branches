{
  "name": "agent-branches-prototype",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "sidecar": "node local-artifacts/sidecar.mjs",
    "test": "vitest run",
    "test:sidecar": "node --test \"local-artifacts/*.test.mjs\"",
    "build:node": "tsc -p tsconfig.node.json",
    "test:node": "npm run build:node && node --test \".build/node/test/node/*.test.js\"",
    "test:all": "npm run typecheck && npm test && npm run test:sidecar && npm run test:node",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
